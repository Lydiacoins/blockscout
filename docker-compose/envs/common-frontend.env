# =============================================================================
# Lydia Coin / USAD - Blockscout Frontend Configuration
# =============================================================================

# --- API & App Connection ---
NEXT_PUBLIC_API_HOST=localhost:4000
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=localhost:4000
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# --- Network Identity ---
NEXT_PUBLIC_NETWORK_NAME=Lydia Coin
NEXT_PUBLIC_NETWORK_SHORT_NAME=LYDIA
NEXT_PUBLIC_NETWORK_ID=1989
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Buy Sell Win
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=BSW
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_IS_TESTNET=false

# --- RPC for Wallet Connection ---
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.lydiacoins.com

# --- Branding: Theme ---
NEXT_PUBLIC_COLOR_THEME_DEFAULT=midnight

# --- Branding: Logos & Icons (mounted into frontend container at /app/public/brand-assets/) ---
NEXT_PUBLIC_NETWORK_LOGO=http://localhost:4000/brand-assets/usad-logo.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=http://localhost:4000/brand-assets/usad-logo.png
NEXT_PUBLIC_NETWORK_ICON=http://localhost:4000/brand-assets/lydiacoin-logo.png
NEXT_PUBLIC_NETWORK_ICON_DARK=http://localhost:4000/brand-assets/lydiacoin-logo.png

# --- Branding: Favicon (uses file:// for in-container access during startup) ---
FAVICON_MASTER_URL=file:///app/public/brand-assets/lydiacoin-logo.png

# --- Branding: Remove Blockscout from Title ---
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# --- Branding: Social Sharing (OG) ---
NEXT_PUBLIC_OG_IMAGE_URL=http://localhost:4000/brand-assets/usad-banner.png
NEXT_PUBLIC_OG_DESCRIPTION=Lydia Coin Explorer - USAD Stablecoin: Future-Ready Stability. Explore transactions, blocks, and tokens on the Lydia Coin network.

# --- Branding: Hero Banner (homepage) ---
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG='{"background":["linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(15,5,5,0.85) 45%, rgba(30,8,8,0.7) 75%, rgba(185,28,28,0.55) 100%), url(/brand-assets/usad-banner.png) center/cover no-repeat","linear-gradient(to right, rgba(10,10,10,0.92) 0%, rgba(15,5,5,0.85) 45%, rgba(30,8,8,0.7) 75%, rgba(185,28,28,0.55) 100%), url(/brand-assets/usad-banner.png) center/cover no-repeat"],"text_color":["#FFFFFF","#FFFFFF"],"border":["rgba(185,28,28,0.35)","rgba(185,28,28,0.35)"],"button":{"_default":{"background":["#B91C1C","#B91C1C"],"text_color":["#FFFFFF","#FFFFFF"]},"_hover":{"background":["#DC2626","#DC2626"],"text_color":["#FFFFFF","#FFFFFF"]},"_selected":{"background":["#991B1B","#991B1B"],"text_color":["#FFFFFF","#FFFFFF"]}}}'

# --- Branding: Footer Links ---
NEXT_PUBLIC_FOOTER_LINKS='[{"title":"Lydia Coins","links":[{"text":"Official Website","url":"https://lydiacoins.com"},{"text":"USAD Stablecoin","url":"https://lydiacoins.com"},{"text":"Documentation","url":"https://lydiacoins.com"}]},{"title":"Community","links":[{"text":"Twitter / X","url":"https://x.com/lydiacoins"},{"text":"Telegram","url":"https://t.me/lydiacoins"}]},{"title":"Explore","links":[{"text":"API Documentation","url":"http://localhost:4000/api-docs"},{"text":"GraphQL","url":"http://localhost:4000/graphiql"}]}]'

# --- Disable All Ads ---
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# --- Layout ---
NEXT_PUBLIC_NAVIGATION_LAYOUT=vertical

# --- Charts ---
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]

# --- Microservice Endpoints ---
NEXT_PUBLIC_STATS_API_HOST=http://localhost:8080
NEXT_PUBLIC_VISUALIZE_API_HOST=http://localhost:8081
